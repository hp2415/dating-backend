# Copy to /opt/dating/.env on the server (chmod 600). Do not commit the real file.
# Passwords: use long random alphanumeric strings. Avoid @ : / # in DB passwords
# or URL-encode them yourself.

APP_ENV=staging
APP_NAME=dating-backend

# Host port for Nginx (cloud: 80). Local override uses 8080 via compose.app.local.yml
HTTP_PORT=80

# Docker Hub mirror when the server cannot reach registry-1.docker.io (same as wp_postgres)
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine

# Reusing wp_postgres / wp_redis on the same host (published on host 5432 / 6379):
POSTGRES_HOST=wp_postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
REDIS_HOST=wp_redis
REDIS_URL=redis://wp_redis:6379/0
# Docker network where wp_postgres / wp_redis also run (docker network ls)
WP_NETWORK=work_place_default

# --- JWT (must differ from local dev) ---
JWT_SECRET=replace-with-long-random-jwt
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=30

# --- Object storage: Aliyun OSS (no MinIO on the cloud server) ---
# Create a bucket, then an AccessKey with OSS permissions. Region example: cn-hangzhou
OSS_BUCKET=dating-media
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://dating-media.oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY=LTAI-replace-me
OSS_SECRET_KEY=replace-oss-secret
OSS_REGION=oss-cn-hangzhou

# Local-only MinIO (first-up.sh --minio). Leave unused on the cloud.
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=replace-minio-password

# --- SMS (dev shortcut; remove when Aliyun SMS is wired) ---
SMS_DEV_CODE=123456
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT=20
MIN_AGE=18

# --- Admin ---
ADMIN_JWT_SECRET=replace-with-long-random-admin-jwt
ADMIN_JWT_TTL_MINUTES=480
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=replace-strong-admin-password
# Same-origin via Nginx: add http://YOUR_PUBLIC_IP and any domain
ADMIN_CORS_ORIGINS=http://127.0.0.1,http://localhost

# --- Product flags ---
DISCOVER_PAGE_SIZE=10
DAILY_LIKE_LIMIT=100
NEW_USER_LIKE_LIMIT=30
SEED_DEMO_USERS=true
SEED_DEMO_USER_COUNT=40
IM_PROVIDER=noop
