APP_ENV=development
APP_NAME=dating-backend
API_PORT=8000

# PostgreSQL 16
POSTGRES_USER=dating
POSTGRES_PASSWORD=dating_dev_password
POSTGRES_DB=dating
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dating:dating_dev_password@postgres:5432/dating

# Redis 7
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT (change in production)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=30

# Local MinIO (OSS stand-in)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19010
OSS_BUCKET=dating-media
OSS_ENDPOINT=http://minio:9000
OSS_PUBLIC_ENDPOINT=http://localhost:19000
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_REGION=us-east-1

# Dev SMS
SMS_DEV_CODE=123456
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT=20
MIN_AGE=18

# Admin (no SMS; default account seeded on startup)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_JWT_TTL_MINUTES=480
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@123456
# Host port for admin web (avoid Windows Hyper-V excluded ranges that often include 5173)
ADMIN_PORT=15173
ADMIN_CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Discover / M2
DISCOVER_PAGE_SIZE=10
DAILY_LIKE_LIMIT=100
NEW_USER_LIKE_LIMIT=30
SEED_DEMO_USERS=true
SEED_DEMO_USER_COUNT=40
IM_PROVIDER=noop
